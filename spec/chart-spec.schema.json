{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dharmik136/peakcharts/blob/master/spec/chart-spec.schema.json",
  "title": "PeakCharts Chart Spec",
  "description": "Language-agnostic recipe for one chart. Every PeakCharts language library builds this shape and renders it. Keep language spec models (e.g. libs/python/peakcharts/spec.py) in lockstep with this file.",
  "type": "object",
  "required": ["type", "series"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["line"],
      "description": "Chart type id. The enum grows as chart types are added; each maps to charts/<id>/design.md."
    },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "width": { "type": "integer", "minimum": 100, "default": 820 },
    "height": { "type": "integer", "minimum": 100, "default": 460 },
    "legend": { "type": "boolean", "default": true },
    "xAxis": { "$ref": "#/definitions/axis" },
    "yAxis": { "$ref": "#/definitions/axis" },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/series" }
    }
  },
  "definitions": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Category labels for the axis. On xAxis, index i of each series maps to categories[i]."
        },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "series": {
      "type": "object",
      "required": ["data"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "data": {
          "type": "array",
          "items": { "type": "number" },
          "description": "y-values; x comes from xAxis.categories (or 0..n-1)."
        },
        "color": {
          "type": "string",
          "description": "Optional hex color (e.g. #2f7ed8). Defaults from the built-in palette by series index."
        }
      }
    }
  }
}
