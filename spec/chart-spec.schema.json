{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dharmik136/stonecharts/blob/main/spec/chart-spec.schema.json",
  "title": "StoneCharts Chart Spec",
  "description": "Language-agnostic recipe for one chart. Unknown keys are ignored (forward-compatible); renderers grow field support phase by phase. Keep language spec models (libs/*/spec) in lockstep with this file.",
  "type": "object",
  "required": [
    "type",
    "series"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "line",
        "column",
        "area",
        "bar",
        "scatter",
        "bubble",
        "combo",
        "dumbbell",
        "histogram",
        "candlestick",
        "error-bar",
        "arearange",
        "columnrange",
        "waterfall",
        "bullet",
        "boxplot",
        "lollipop",
        "funnel"
      ],
      "description": "Chart type id for the active release scope (0.0.0.1: line, column, area; 0.0.0.2 admits bar per DEC-014; 0.0.0.3 admits scatter per DEC-015; 0.0.0.4 admits bubble per DEC-016; 0.0.0.5 admits combo; 0.0.0.6 admits histogram per DEC-021; 0.0.0.7 admits candlestick per DEC-022; 0.0.0.8 admits error-bar per DEC-023; 0.0.0.9 admits arearange per DEC-024 and columnrange per DEC-025; 0.0.0.10 admits waterfall per DEC-026; 0.0.0.11 admits bullet per DEC-027; 0.0.0.12 admits boxplot per DEC-028; 0.0.0.13 admits lollipop per DEC-029; 0.0.0.14 admits dumbbell per DEC-030; 0.0.0.15 admits funnel per DEC-031); maps to the released chart design and renderer pair."
    },
    "id": {
      "type": "string",
      "default": "sc",
      "description": "Chart instance id, used to namespace <defs> ids (gradients/patterns) so multiple charts on one page don't collide. Set a unique value per chart when embedding several."
    },
    "theme": {
      "description": "Color theme. A built-in name ('light' = default, byte-identical to the classic look; 'dark'), or a full theme object. Resolved server-side into concrete SVG attributes (never CSS variables).",
      "default": "light",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        {
          "$ref": "#/definitions/theme"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "default": 820
    },
    "height": {
      "type": "integer",
      "default": 460
    },
    "responsive": {
      "type": "boolean",
      "default": false,
      "description": "When true the SVG scales to its container (viewBox + preserveAspectRatio + width:100%) instead of a fixed pixel size. Default false keeps fixed width/height."
    },
    "legend": {
      "type": "boolean",
      "default": true
    },
    "a11y": {
      "type": "boolean",
      "default": true,
      "description": "Accessibility (on by default): SVG gets role=\"img\" + a summary aria-label + <desc>; the HTML output adds a visually-hidden data table. Set false to restore the pre-a11y byte output."
    },
    "layout": {
      "type": "object",
      "description": "Manual chart layout controls. Margin values override the deterministic defaults only when present; they never auto-fit text.",
      "properties": {
        "margin": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0
            },
            "left": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "stacking": {
      "type": "string",
      "enum": [
        "normal",
        "percent"
      ],
      "description": "Stack series values per category. 'normal' = absolute stacked with signed positive/negative accumulators, 'percent' = 100% stacked using non-negative values only. Absent = no stacking."
    },
    "grouping": {
      "type": "boolean",
      "default": true,
      "description": "When true (default) multi-series bars/columns sit side-by-side; when false they overlay."
    },
    "xAxis": {
      "$ref": "#/definitions/axis"
    },
    "yAxis": {
      "$ref": "#/definitions/yAxis"
    },
    "secondaryYAxis": {
      "$ref": "#/definitions/yAxis",
      "description": "Optional second value axis (dual units), drawn on the right. Same shape as yAxis. Series bind to it with series[].yAxis: 1."
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/series"
      }
    },
    "bulletTarget": {
      "type": "number",
      "description": "Bullet chart: comparative target value, drawn as a tick mark across the measure bar."
    },
    "bulletRanges": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Bullet chart: qualitative range bounds (sorted ascending). Defines graded background bands from 0 to each bound."
    },
    "orientation": {
      "type": "string",
      "enum": ["vertical", "horizontal"],
      "default": "vertical",
      "description": "Coordinate orientation. 'vertical' (default) = categories on x, values on y. 'horizontal' = categories on y, values on x."
    },
    "scatterOverlay": {
      "type": "boolean",
      "default": false,
      "description": "Boxplot: when true and samples are present, jittered raw sample points are drawn over each box."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "stacking"
        ],
        "properties": {
          "stacking": {
            "const": "percent"
          }
        }
      },
      "then": {
        "properties": {
          "series": {
            "items": {
              "properties": {
                "data": {
                  "items": {
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["type"],
          "properties": {
            "type": { "enum": ["scatter", "bubble"] }
          }
        }
      },
      "then": {
        "properties": {
          "series": {
            "items": {
              "properties": {
                "data": {
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": { "const": "scatter" }
        }
      },
      "then": {
        "properties": {
          "series": {
            "items": {
              "properties": {
                "data": {
                  "items": {
                    "oneOf": [
                      { "type": "number" },
                      { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                      {
                        "type": "object",
                        "required": ["x", "y"],
                        "additionalProperties": false,
                        "properties": {
                          "x": { "type": "number" },
                          "y": { "type": "number" }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["type"],
        "properties": {
          "type": { "const": "bubble" }
        }
      },
      "then": {
        "properties": {
          "series": {
            "items": {
              "properties": {
                "data": {
                  "items": {
                    "oneOf": [
                      { "type": "number" },
                      { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
                      {
                        "type": "object",
                        "required": ["x", "y", "z"],
                        "additionalProperties": false,
                        "properties": {
                          "x": { "type": "number" },
                          "y": { "type": "number" },
                          "z": { "type": "number" }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "theme": {
      "type": "object",
      "description": "Concrete color set. Canonical values live in spec/themes/*.json; a custom object may override any field. Omitted fields fall back to the light theme.",
      "properties": {
        "name": {
          "type": "string"
        },
        "background": {
          "type": [
            "string",
            "null"
          ],
          "description": "Chart background; null/absent = transparent (no <rect>)."
        },
        "titleColor": {
          "type": "string"
        },
        "subtitleColor": {
          "type": "string"
        },
        "axisLabelColor": {
          "type": "string"
        },
        "axisTitleColor": {
          "type": "string"
        },
        "gridColor": {
          "type": "string"
        },
        "axisLineColor": {
          "type": "string"
        },
        "crosshairColor": {
          "type": "string"
        },
        "markerHalo": {
          "type": "string"
        },
        "legendTextColor": {
          "type": "string"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gradient": {
      "type": "object",
      "description": "Linear gradient. Direction is x1,y1 -> x2,y2 in 0..1 objectBoundingBox coords (default 0,0 -> 0,1 = vertical top-to-bottom). No trig, so both renderers format it identically.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "linearGradient"
          ],
          "default": "linearGradient"
        },
        "x1": {
          "type": "number",
          "default": 0
        },
        "y1": {
          "type": "number",
          "default": 0
        },
        "x2": {
          "type": "number",
          "default": 0
        },
        "y2": {
          "type": "number",
          "default": 1
        },
        "stops": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "offset": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "opacity": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "pattern": {
      "type": "object",
      "description": "Hatch (diagonal-line) fill for the area under the line. Print- and colorblind-friendly. Renders as an SVG <pattern> tile.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hatch"
          ],
          "default": "hatch"
        },
        "color": {
          "type": "string",
          "default": "#333333",
          "description": "Hatch line color."
        },
        "background": {
          "type": "string",
          "description": "Optional solid tile background behind the hatch lines."
        },
        "size": {
          "type": "number",
          "default": 8,
          "description": "Tile size in px (line spacing)."
        },
        "angle": {
          "type": "number",
          "default": 45,
          "description": "Hatch rotation in degrees."
        },
        "strokeWidth": {
          "type": "number",
          "default": 1.5
        }
      }
    },
    "axis": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Category labels. On xAxis, index i of each series maps to categories[i]."
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "opposite": {
          "type": "boolean",
          "default": true,
          "description": "Secondary axis side selector."
        },
        "binEdges": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Histogram x-axis bin edges."
        }
      }
    },
    "yAxis": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "gridLine": {
          "type": "object",
          "description": "Horizontal gridline styling. Defaults reproduce the built-in look (solid #e8e8ee).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "color": {
              "type": "string",
              "description": "Hex color; default #e8e8ee."
            },
            "dashStyle": {
              "type": "string",
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ],
              "default": "solid"
            }
          }
        }
      }
    },
    "series": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "number" },
              { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
              {
                "type": "object",
                "required": ["x", "y"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              },
              { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              {
                "type": "object",
                "required": ["x", "y", "z"],
                "additionalProperties": false,
                "properties": {
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "z": { "type": "number" }
                }
              }
            ]
          },
          "description": "y-values; x comes from xAxis.categories (or 0..n-1). scatter (0.0.0.3, DEC-015) additionally accepts the point model: a positional [x,y] pair or an {x,y} object. bubble (0.0.0.4, DEC-016) additionally accepts [x,y,z] / {x,y,z}. Every other chart type is restricted back to a plain number, and scatter/bubble are each restricted to their own shape, by the type-conditional rules below."
        },
        "color": {
          "description": "Series color: a hex string, or a linear-gradient object (fades between stops). Gradient applies to the stroke and area fill; markers/legend use the first stop's color.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/gradient"
            }
          ]
        },
        "fillOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Fill the area under the line down to the zero baseline at this opacity. 0 = no fill (default). Any value > 0 turns a line chart into an area chart."
        },
        "pattern": {
          "$ref": "#/definitions/pattern"
        },
        "lineWidth": {
          "type": "number",
          "default": 2
        },
        "dashStyle": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ],
          "default": "solid"
        },
        "step": {
          "type": "string",
          "enum": [
            "before",
            "after",
            "center"
          ],
          "description": "Draw as a stepped line instead of straight segments."
        },
        "curve": {
          "type": "string",
          "enum": [
            "linear",
            "monotone"
          ],
          "description": "Line interpolation. 'monotone' = smooth Fritsch-Carlson spline (no overshoot). Default = straight segments."
        },
        "marker": {
          "type": "object",
          "description": "Data-point markers. Defaults reproduce the built-in circle (r 3.5).",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "symbol": {
              "type": "string",
              "enum": [
                "circle",
                "square",
                "triangle",
                "diamond"
              ],
              "default": "circle"
            },
            "radius": {
              "type": "number",
              "default": 3.5
            }
          }
        },
        "type": {
          "type": "string",
          "enum": ["line", "column"],
          "default": "column",
          "description": "Per-series mark kind for combo charts. 'column' = baseline-anchored rect; 'line' = path + markers."
        },
        "yAxis": {
          "type": "integer",
          "enum": [0, 1],
          "default": 0,
          "description": "Which value axis this series is measured against: 0 = primary yAxis (default), 1 = secondaryYAxis."
        },
        "boxData": {
          "type": "array",
          "description": "Boxplot: 5-number summary per category. Each element is {low, q1, median, q3, high, outliers?}.",
          "items": {
            "type": "object",
            "required": ["low", "q1", "median", "q3", "high"],
            "properties": {
              "low": { "type": "number" },
              "q1": { "type": "number" },
              "median": { "type": "number" },
              "q3": { "type": "number" },
              "high": { "type": "number" },
              "outliers": {
                "type": "array",
                "items": { "type": "number" }
              }
            }
          }
        },
        "samples": {
          "type": "array",
          "description": "Boxplot: raw sample arrays per category (renderer computes the 5-number summary).",
          "items": {
            "type": "array",
            "items": { "type": "number" }
          }
        }
      }
    }
  }
}
