{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stonecharts.dev/schemas/requirements-registry.schema.json",
  "title": "StoneCharts requirements registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "updated", "requirements"],
  "properties": {
    "id": { "const": "SC-REQ-REGISTRY" },
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "format": "date" },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "statement", "rationale", "kind", "priority", "status",
        "owner", "target", "source", "acceptance", "decisions", "contracts",
        "verification", "implementation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[A-Z][A-Z0-9]*-\\d{3}$" },
        "title": { "type": "string", "minLength": 3 },
        "statement": { "type": "string", "minLength": 10 },
        "rationale": { "type": "string", "minLength": 10 },
        "kind": { "enum": ["functional", "quality", "constraint", "security", "delivery"] },
        "priority": { "enum": ["must", "should", "may"] },
        "status": { "enum": ["proposed", "approved", "implemented", "verified", "deferred", "rejected"] },
        "owner": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^SC-(GOV|PROD|REQ|ARCH|CON|QUAL|SEC|REL|USER|OPS)-(\\d{3}|ADR-\\d{4})$" },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "decisions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SC-ARCH-ADR-\\d{4}$" },
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SC-CON-\\d{3}$" },
          "uniqueItems": true
        },
        "verification": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(TEST|BENCH|REVIEW)-[A-Z0-9-]+$" },
          "uniqueItems": true
        },
        "implementation": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
