{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stonecharts.dev/schemas/project-backlog.schema.json",
  "title": "StoneCharts project backlog registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "updated", "project", "workflow", "items"],
  "properties": {
    "id": { "const": "SC-OPS-BACKLOG" },
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "format": "date" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "number", "repository", "milestone", "views"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "milestone": { "const": "0.0.0.1" },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/view" }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "priorities", "workstreams", "stages", "targets", "item_types"],
      "properties": {
        "statuses": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "priorities": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "workstreams": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "stages": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "targets": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "item_types": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "layout", "filter", "fields", "group_by"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "layout": { "enum": ["BOARD_LAYOUT", "TABLE_LAYOUT", "ROADMAP_LAYOUT"] },
        "filter": { "type": "string" },
        "fields": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "group_by": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "item_type", "status", "priority", "workstream",
        "stage", "target", "outcome", "traceability", "risks", "evidence",
        "dependencies", "compatibility", "areas"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(DEC|REQ|WORK|GATE)-[A-Z0-9-]+$"
        },
        "title": { "type": "string", "minLength": 5 },
        "item_type": { "enum": ["Decision", "Requirement", "Work Package", "Defect", "Release Gate"] },
        "status": {
          "enum": ["Inbox", "Triage", "Ready", "In Progress", "In Review", "Qualification", "Blocked", "Done"]
        },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "workstream": {
          "enum": [
            "WS-01 Governance", "WS-02 Renderer", "WS-03 Conformance",
            "WS-04 Runtime & A11y", "WS-05 Customization", "WS-06 Release",
            "WS-07 Docs & DX", "WS-08 Expansion"
          ]
        },
        "stage": {
          "enum": [
            "S0 Foundation", "S1 Contract Closure", "S2 Qualification",
            "S3 Release Candidate", "S4 Release", "S5 Expansion",
            "S6 Qualification 0.0.0.2", "S7 Release Candidate 0.0.0.2", "S8 Release 0.0.0.2",
            "S9 Qualification 0.0.0.3", "S10 Release Candidate 0.0.0.3", "S11 Release 0.0.0.3"
          ]
        },
        "target": { "enum": ["0.0.0.1", "0.0.0.2", "0.0.0.3", "Post-0.0.0.1", "Unscheduled"] },
        "outcome": { "type": "string", "minLength": 15 },
        "traceability": { "$ref": "#/$defs/uniqueStrings" },
        "risks": { "$ref": "#/$defs/uniqueStrings" },
        "evidence": { "$ref": "#/$defs/uniqueStrings" },
        "dependencies": { "$ref": "#/$defs/uniqueStrings" },
        "compatibility": { "type": "string", "minLength": 3 },
        "areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["spec", "python", "go", "runtime", "docs", "release", "security"] }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
