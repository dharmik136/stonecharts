{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stonecharts.dev/schemas/roles.schema.json",
  "title": "StoneCharts controlled roles",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "updated", "roles"],
  "properties": {
    "id": { "const": "SC-GOV-004" },
    "title": { "type": "string", "minLength": 3 },
    "status": { "enum": ["draft", "proposed", "approved", "archived"] },
    "updated": { "type": "string", "format": "date" },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["holder", "responsibilities"],
        "properties": {
          "holder": { "type": "string", "minLength": 1 },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          }
        }
      }
    }
  }
}
