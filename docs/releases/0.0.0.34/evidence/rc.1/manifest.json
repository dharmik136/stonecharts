  "risks": [
    {
      "id": "RISK-001",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Released schema overstates renderer support. Restrict the active schema to released types and add explicit renderer capability validation."
    },
    {
      "id": "RISK-002",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Schema and handwritten validators disagree. Ratify one rule set, encode it in all three validators, and add shared accept-and-reject fixtures."
    },
    {
      "id": "RISK-003",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Accepted input can panic or throw during dispatch. Make render entry points return canonical typed errors for every user-controlled failure."
    },
    {
      "id": "RISK-004",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Mixed-sign normal stacking has an invalid domain. Use separate positive and negative accumulators in both the domain and mark transforms."
    },
    {
      "id": "RISK-005",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Percent stacking has ambiguous signed semantics. Restrict 0.0.0.1 percent stacking to finite non-negative values and define all-zero categories explicitly."
    },
    {
      "id": "RISK-006",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Unicode legend geometry differs by language. Define one Unicode length model and lock it with cross-language fixtures."
    },
    {
      "id": "RISK-007",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Fixed margins can clip real-world labels. Add validated manual margins and publish the no-auto-fit 0.0.0.1 limitation."
    },
    {
      "id": "RISK-008",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Runtime interaction and accessibility gaps. Ratify runtime semantics and add automated browser plus manual accessibility qualification."
    },
    {
      "id": "RISK-009",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Package version conflicts with planned release. Adopt ecosystem-specific version mappings and verify every emitted package before tagging."
    },
    {
      "id": "RISK-010",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Short category arrays can break generated HTML. Pad short category arrays deterministically with numeric labels and add shared HTML tests."
    },
    {
      "id": "RISK-011",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Byte identity may be misrepresented as pixel identity. Publish separate canonical, embedded-font, and certified-export guarantee profiles."
    },
    {
      "id": "RISK-012",
      "disposition": "closed",
      "expires": null,
      "rationale": "Closed: Release provenance is not yet reproducible. Build the 0.0.0.1 evidence pack and supply-chain workflow before public distribution."
    },
    {
      "id": "RISK-013",
      "disposition": "accepted",
      "expires": null,
      "rationale": "Accepted: No automated branch-protection gate on main. Rely on the governed Stage-gate release process and the solo-maintainer risk-acceptance policy in threat-model.md until the repository qualifies for a tier with branch protection (GitHub Pro, or making the repository public)."
    },
    {
      "id": "RISK-014",
      "disposition": "accepted",
      "expires": null,
      "rationale": "Accepted: No GitHub-native private vulnerability reporting. Enable GitHub-native private vulnerability reporting once available on this repository's tier. Until then, SECURITY.md's documented fallback (contact the repository owner through GitHub to establish a private channel) is the operational reporting path."
    }
  ],
  "knownLimits": [
    "Package-registry and other external distribution channels remain unapproved and were not used.",
    "No real customer pilot has been executed; customer validation remains a separate external milestone.",
    "Pixel identity is claimed only under a named certified export profile, not arbitrary viewers."
  ],
