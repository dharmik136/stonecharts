---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  activeNav?: string;
}

const { title, activeNav } = Astro.props;

const navLinks = [
  { href: '/demo/', label: 'Overview', key: 'overview' },
  { href: '/demo/gallery/', label: 'Gallery', key: 'gallery' },
  { href: '/demo/benchmarks/', label: 'Benchmarks', key: 'benchmarks' },
  { href: '/demo/verify/', label: 'Verify', key: 'verify' },
];
---
<BaseLayout title={`${title} — StoneCharts Demo`}>
  <header style="background: var(--bg-surface); border-bottom: 1px solid var(--border);">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between; padding-top: 0.75rem; padding-bottom: 0.75rem;">
      <a href="/demo/" style="font-weight: 700; font-size: 1.1rem; color: var(--text);">
        StoneCharts <span style="color: var(--text-tertiary); font-weight: 400; font-size: 0.8rem;">demo</span>
      </a>
      <button id="theme-toggle" class="btn btn-ghost" style="padding: 0.4rem 0.75rem; font-size: 0.8rem;">
        Light / Dark
      </button>
    </div>
    <div class="container">
      <nav class="demo-nav">
        {navLinks.map(link => (
          <a href={link.href} class={activeNav === link.key ? 'active' : ''}>
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main class="container section">
    <slot />
  </main>

  <footer style="border-top: 1px solid var(--border); padding: 2rem 0; text-align: center; font-size: 0.8rem; color: var(--text-tertiary);">
    <div class="container">
      This demo contains rendered chart outputs and measured benchmark data only. No source code or packages are distributed.
    </div>
  </footer>

  <script is:inline src="/chart-interactions.js"></script>
  <script is:inline>
    (function() {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function() {
        var html = document.documentElement;
        var current = html.getAttribute('data-theme') || 'light';
        var next = current === 'light' ? 'dark' : 'light';
        html.setAttribute('data-theme', next);
        localStorage.setItem('sc-theme', next);
        if (window.StoneCharts) window.StoneCharts.init();
      });
    })();
  </script>
</BaseLayout>
