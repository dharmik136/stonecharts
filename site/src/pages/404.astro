---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noIndex={true}>
  <div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center;">
    <div>
      <p style="font-size: 5rem; font-weight: 700; color: var(--accent); margin: 0; line-height: 1;">404</p>
      <h1 style="font-size: 1.5rem; margin: 1rem 0 0.5rem;">Page not found</h1>
      <p style="color: var(--text-secondary); margin-bottom: 2rem;">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div style="display: flex; gap: 0.75rem; justify-content: center;">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/demo/" class="btn btn-ghost">Go to demo</a>
      </div>
    </div>
  </div>
</BaseLayout>
