---
import DemoLayout from '../../layouts/DemoLayout.astro';
import ChartEmbed from '../../components/ChartEmbed.astro';
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';

const CHART_TYPES = [
  { id: 'line-basic', label: 'Line', desc: 'Multi-series line chart with optional spline interpolation, markers, and gradient strokes.' },
  { id: 'column', label: 'Column', desc: 'Vertical bar charts with grouped and stacked variants.' },
  { id: 'area', label: 'Area', desc: 'Filled area charts with normal and percent stacking.' },
  { id: 'bar', label: 'Bar', desc: 'Horizontal bar charts with grouped and stacked variants.' },
  { id: 'scatter', label: 'Scatter', desc: 'XY point charts with correlation and regression line support.' },
  { id: 'bubble', label: 'Bubble', desc: 'Three-dimensional data mapped to position and bubble size.' },
  { id: 'combo', label: 'Combo', desc: 'Per-series mark types (column + line) on shared axes with optional dual y-axis.' },
  { id: 'histogram', label: 'Histogram', desc: 'Frequency distribution with binning transform, optional pareto line and bellcurve overlay.' },
  { id: 'candlestick', label: 'Candlestick', desc: 'OHLC financial chart with candlestick, ohlc, hlc, heikin-ashi, and hollow subtypes.' },
  { id: 'error-bar', label: 'Error Bar', desc: 'Whisker marks showing center value with low/high uncertainty bounds.' },
  { id: 'arearange', label: 'Area Range', desc: 'Band-fill between low and high data paths for intervals and envelopes.' },
  { id: 'columnrange', label: 'Column Range', desc: 'Floating bars between low and high values per category.' },
  { id: 'waterfall', label: 'Waterfall', desc: 'Signed deltas as floating bars with running-total transform and connector lines.' },
  { id: 'bullet', label: 'Bullet', desc: 'Compact KPI bar against qualitative range bands and a comparison target.' },
  { id: 'boxplot', label: 'Boxplot', desc: 'Box-and-whisker glyphs showing 5-number summary with optional outliers per category.' },
  { id: 'lollipop', label: 'Lollipop', desc: 'Thin stems from the baseline capped with marker heads for low-ink category comparison.' },
  { id: 'dumbbell', label: 'Dumbbell', desc: 'Connected-dot plot with two marker heads (low + high) joined by a thin connector per category.' },
  { id: 'funnel', label: 'Funnel', desc: 'Centered trapezoid stack with value-to-width scaling for conversion and drop-off visualization.' },
  { id: 'variwide', label: 'Variwide', desc: 'Column chart where each bar width also encodes a value via cumulative-width x-layout.' },
  { id: 'timeline', label: 'Timeline', desc: 'Events placed along a time axis with markers, leader lines, and alternating labels.' },
  { id: 'windbarb', label: 'Windbarb', desc: 'Meteorological wind-barb glyphs encoding speed (feathers) and direction (rotation) on a fixed lane.' },
];

const chartsDir = join(process.cwd(), 'src', 'assets', 'charts');
const specsDir = join(process.cwd(), 'src', 'assets', 'specs');

type ChartData = {
  id: string;
  label: string;
  desc: string;
  lightSvg: string;
  darkSvg: string | undefined;
  spec: string;
};

const charts: ChartData[] = [];

for (const ct of CHART_TYPES) {
  const goldenDir = join(chartsDir, ct.id);
  const files = await readdir(goldenDir);

  const lightFile = files.includes('basic.svg') ? 'basic.svg' : files.find(f => f.endsWith('.svg') && !f.includes('dark') && !f.includes('adversarial'));
  const darkFile = files.find(f => f === 'themed-dark.svg') || files.find(f => f === 'dark.svg');

  const lightSvg = lightFile ? await readFile(join(goldenDir, lightFile), 'utf-8') : '';
  const darkSvg = darkFile ? await readFile(join(goldenDir, darkFile), 'utf-8') : undefined;

  let spec = '';
  try {
    const specFile = join(specsDir, ct.id, 'basic.json');
    spec = await readFile(specFile, 'utf-8');
  } catch {
    spec = '// spec not available';
  }

  charts.push({ ...ct, lightSvg, darkSvg, spec });
}
---
<DemoLayout title="Chart Gallery" activeNav="gallery">
  <div style="margin-bottom: 2.5rem;">
    <h1 style="margin-bottom: 0.5rem;">Chart Gallery</h1>
    <p style="color: var(--text-secondary); max-width: 640px; margin-bottom: 1rem;">
      Twenty-one certified chart types, each rendered identically in Python and Go.
      Every SVG below is actual golden output from the certified renderers —
      not a screenshot, not a mockup.
    </p>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <span class="badge-success badge">0 dependencies</span>
      <span class="badge">Byte-identical</span>
      <span style="font-size: 0.8125rem; color: var(--text-tertiary);">
        Hover for tooltips · Click legends to toggle · Arrow keys for keyboard nav
      </span>
    </div>
  </div>

  {charts.map((chart) => (
    <div class="chart-section" id={chart.id}>
      <div class="chart-section-header">
        <div>
          <h2 style="margin-bottom: 0.25rem;">{chart.label}</h2>
          <p style="color: var(--text-secondary); margin: 0; font-size: 0.875rem;">{chart.desc}</p>
        </div>
      </div>
      <div class="chart-grid">
        <div>
          <ChartEmbed
            lightSvg={chart.lightSvg}
            darkSvg={chart.darkSvg}
            chartType={chart.id}
            chartName="basic"
          />
        </div>
        <div class="spec-viewer card" style="padding: 0; overflow: hidden;">
          <div style="padding: 0.5rem 1rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em;">
              Chart Spec (JSON)
            </span>
          </div>
          <pre style="margin: 0; border: 0; border-radius: 0; max-height: 380px; overflow-y: auto;"><code>{chart.spec}</code></pre>
        </div>
      </div>
    </div>
  ))}
</DemoLayout>
